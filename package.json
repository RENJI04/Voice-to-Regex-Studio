{
  "name": "voice-to-regex-studio",
  "private": true,
  "version": "0.0.0",
  "description": "A React studio for generating, testing, explaining, and hardening regular expressions from natural language.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RENJI04/Voice-to-Regex-Studio.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "npm run test:regression",
    "test:regression": "node scripts/run-regression-suite.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
