# Required build-time environment variables: none.
#
# Users enter provider API keys in the in-app settings panel. Do not put real
# Anthropic, OpenAI, or custom endpoint keys in this file.
#
# Optional production backend configuration:
# RENEX_PORT=3000
# RENEX_ALLOWED_ORIGIN=https://renex.example.com
# RENEX_PROVIDER_TIMEOUT_MS=15000
# RENEX_MAX_BODY_BYTES=65536
# RENEX_REQUEST_BODY_TIMEOUT_MS=10000
# RENEX_MAX_PROVIDER_RESPONSE_BYTES=1048576
# RENEX_DNS_TIMEOUT_MS=3000
# RENEX_CUSTOM_PROVIDER_MODE=public
# RENEX_CUSTOM_PROVIDER_HOSTS=api.example.com
# RENEX_CUSTOM_PROVIDER_PORTS=80,443
# RENEX_RATE_LIMIT=60
# RENEX_RATE_LIMIT_WINDOW_MS=60000
# RENEX_RATE_LIMIT_MAX_CLIENTS=10000
# RENEX_TRUST_PROXY=false
